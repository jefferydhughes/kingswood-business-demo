NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ASK_KINGSWOOD_ENABLED=false

# Salesforce — server only. Use a dedicated API-only integration user.
SALESFORCE_LOGIN_URL=https://test.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v66.0
SALESFORCE_EXTERNAL_ID_FIELD=Website_Submission_ID__c
SALESFORCE_DEFAULT_COMPANY=Individual Prospect
SALESFORCE_CAMPAIGN_ID=

# CMS values are activated in the Payload implementation slice.
DATABASE_URL=
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=

# Inquiry email (Resend). Sends each form submission to the recruiting contact.
# INQUIRY_FROM must be a sender on a domain verified in Resend.
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
INQUIRY_FROM=
# Review mode shows the approval banner and status labels. Set to false only after programs are approved.
NEXT_PUBLIC_REVIEW_MODE=true
# Shows the "new programs in development" interest line on /encounter. Set to true only with the president's approved wording.
NEXT_PUBLIC_SHOW_INTEREST_LIST=false
